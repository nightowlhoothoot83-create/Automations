{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/pod-production-run-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "automationId", "status", "startedAt", "finishedAt", "summary", "evidence", "approval"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "automationId": { "const": "automation-6-pod-production" },
    "status": { "enum": ["blocked", "pending-owner-approval"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["selectedProducts", "masterWidthPx", "masterHeightPx", "estimatedCredits", "missingEvidenceCount"]
    },
    "evidence": { "type": "object" },
    "approval": {
      "type": "object",
      "required": ["required", "status", "actionClass"],
      "properties": {
        "required": { "const": true },
        "status": { "const": "pending" },
        "actionClass": { "const": "pod-product-draft-approval" }
      }
    }
  }
}
