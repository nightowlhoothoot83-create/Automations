  "podPrintReadiness": {
    "targetDpi": 300,
    "dimensionsSource": "selected-product-provider-template",
    "allowedFormats": ["PNG", "JPEG"],
    "colourProfile": "sRGB unless the print provider specifies otherwise",
    "requireTransparencyWhenProductNeedsIt": true,
    "requireBleedAndSafeAreaValidation": true,
    "rejectLowResolutionOrVisibleArtifacts": true,
    "rule": "DPI metadata alone is insufficient; pixel dimensions must satisfy the selected product template at target print size"
