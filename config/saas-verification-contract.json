      "requiredChecks": ["product-preview-generation", "image-generation-output-quality", "product-template-dimensions", "print-resolution", "print-format", "colour-profile", "transparency-when-required", "bleed-and-safe-area", "artifact-detection", "provider-migration-readiness", "save-and-reload-persistence"],
