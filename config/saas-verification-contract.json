{
  "schemaVersion": "1.0.0",
  "mode": "read-only",
  "products": [
    { "id": "ad-manager", "publicUrl": "https://ads.raven-sharp.com/", "backendHealthUrl": null, "stripeTestUrl": null },
    { "id": "book-creator", "publicUrl": "https://books.raven-sharp.com/", "backendHealthUrl": null, "stripeTestUrl": null },
    { "id": "content-creator", "publicUrl": "https://content.raven-sharp.com/", "backendHealthUrl": null, "stripeTestUrl": null },
    { "id": "smart-cleaner", "publicUrl": "https://cleaner.raven-sharp.com/", "backendHealthUrl": null, "stripeTestUrl": null },
    {
      "id": "image-optimiser", "publicUrl": "https://opt.raven-sharp.com/", "backendHealthUrl": null, "stripeTestUrl": null,
      "requiredChecks": ["physical-print-size-planning", "target-dpi", "source-effective-resolution", "upscale-factor", "provider-dimension-limits", "tiled-upscale-when-required", "seam-detection", "fine-art-detail-preservation", "colour-profile", "output-format", "estimated-cost-before-run", "tier-quota-protection", "large-output-storage-and-download"]
    },
    {
      "id": "pod-automation", "publicUrl": "https://pod.raven-sharp.com/", "backendHealthUrl": null, "stripeTestUrl": null,
      "requiredChecks": ["product-preview-generation", "image-generation-output-quality", "provider-ab-same-prompt-analysis", "product-template-dimensions", "print-resolution", "print-format", "colour-profile", "transparency-when-required", "bleed-and-safe-area", "artifact-detection", "provider-migration-readiness", "save-and-reload-persistence"],
      "connectionsRequired": ["fal-key-environment-variable", "webhook-endpoint"],
      "providerArchitecture": {
        "selectionMode": "independent-per-stage-after-benchmark",
        "artworkGeneration": { "status": "pending-owner-review", "default": "fal.ai FLUX 1.1 Pro", "candidates": ["current Runware", "fal.ai FLUX 1.1 Pro", "fal.ai FLUX.1 Schnell (draft only)"] },
        "previewGeneration": { "status": "pending-owner-review", "candidates": ["current Runware", "fal.ai FLUX.1 Schnell"] },
        "allowDifferentProviders": true,
        "falCandidate": { "clientPackage": "@fal-ai/client", "model": "FLUX 1.1 Pro", "endpointId": "fal-ai/flux-pro/v1.1", "draftEndpointId": "fal-ai/flux-1/schnell", "credentialEnv": "FAL_KEY" }
      },
      "suitabilityAnalysisProvider": { "provider": "Claude Vision", "use": "analyse image suitability for the selected POD product", "change": "none" }
    }
  ],
  "requiredSurfaces": [
    "public-frontend", "core-product-information", "pricing", "pricing-stripe-parity", "authentication", "dashboard",
    "advertised-claim-coverage", "every-core-feature-workflow", "api-calls", "preview-or-rendering", "results-or-output",
    "save-and-reload-persistence", "storage-read-write", "backend-health", "webhook-delivery", "stripe-test-surface",
    "privacy", "terms", "contact-or-support", "header", "footer", "desktop", "mobile"
  ],
  "functionalRule": "Every advertised capability must map to passing evidence; a visual pass cannot override any claim, API, workflow, preview, save, persistence, storage, or backend failure",
  "stripeRule": "Test mode or non-transactional inspection only; never complete a live charge",
  "pricingParityFields": ["tier-name", "amount", "currency", "billing-interval", "trial", "included-features-or-limits", "checkout-destination"],
  "podPrintReadiness": {
    "targetDpi": 300,
    "dimensionsSource": "selected-product-provider-template",
    "allowedFormats": ["PNG", "JPEG"],
    "colourProfile": "sRGB unless the print provider specifies otherwise",
    "requireTransparencyWhenProductNeedsIt": true,
    "requireBleedAndSafeAreaValidation": true,
    "rejectLowResolutionOrVisibleArtifacts": true,
    "rule": "DPI metadata alone is insufficient; pixel dimensions must satisfy the selected product template at target print size"
  },
  "podTrendIntelligence": {
    "enabledByDefault": true,
    "mode": "read-only-research",
    "refreshCadence": "daily-or-before-a-generation-batch",
    "configurableSources": ["marketplace-search-trends", "social-trend-signals", "print-provider-trend-feeds", "seasonal-calendar"],
    "signals": ["rising-topics", "colour-palettes", "visual-styles", "patterns", "product-categories", "audience-niches", "seasonality", "trend-velocity", "saturation-risk"],
    "firstGenerationChoice": "trend-informed-original-concept",
    "fallbackChoice": "evergreen-niche-concept",
    "rules": [
      "Use current trend signals as creative direction, not as assets to copy",
      "Prefer trends relevant to the selected audience, product and marketplace",
      "Reject protected characters, brands, logos, celebrity likenesses, copied artwork and unsafe themes",
      "Avoid generic AI sameness and oversaturated trends unless the concept adds a distinctive angle",
      "Record source, capture time, signal age and rationale with every trend-informed prompt",
      "Keep generated work in review until originality, print readiness, product fit and owner approval pass"
    ],
    "requiredEvidence": ["source-reference", "captured-at", "trend-summary", "target-audience", "target-product", "prompt-rationale", "originality-check", "saturation-assessment"]
  },
  "podArtDirection": {
    "compileStructuredPrompt": true,
    "finalArtworkModel": "fal-ai/flux-pro/v1.1",
    "draftOnlyModel": "fal-ai/flux-1/schnell",
    "requiredPromptSections": ["creative-brief", "art-direction", "composition", "production-finish", "output-isolation", "avoid"],
    "minimumOverallReviewScore": 80,
    "automaticFailure": ["generic-clip-art", "generic-app-icon", "large-unintended-blank-area", "missing-requested-style", "visible-generation-artifact", "watermark-or-unrequested-text"],
    "failedOutputAction": "reject-and-regenerate-with-targeted-correction"
  },
  "imageOptimiserPrintSizing": {
    "physicalUnits": ["millimetres", "centimetres", "inches"],
    "supportedIntentPresets": [
      { "id": "fine-art-close-view", "targetDpi": 300 },
      { "id": "photographic-print", "targetDpi": 240 },
      { "id": "large-wall-art", "targetDpi": 150 }
    ],
    "calculation": "requiredPixelsPerEdge = physicalSizeInInches * targetDpi",
    "referenceCases": [
      { "widthMm": 1000, "heightMm": 1000, "targetDpi": 300, "requiredWidthPx": 11811, "requiredHeightPx": 11811, "approxMegapixels": 139.5 }
    ],
    "preflight": ["source-width-height", "source-effective-dpi-at-target-size", "required-upscale-factor", "provider-maximum-output", "estimated-provider-cost", "estimated-storage-size", "tier-quota-impact"],
    "gates": [
      "Show target dimensions, effective DPI, upscale factor and estimated cost before generation",
      "Do not silently reduce DPI or physical dimensions",
      "Do not start an upscale that exceeds the user's remaining plan allowance or configured per-job cost ceiling",
      "Require explicit confirmation when a job crosses the configured high-cost or extreme-dimension threshold",
      "Use tiled processing only when the provider cannot produce the required dimensions in one pass",
      "Reject visible seams, hallucinated detail, sharpened halos, colour shifts and altered artwork"
    ],
    "defaultMode": "estimate-and-preview-only",
    "productionExecution": "approval-gated"
  },
  "imageOptimiserUnitEconomics": {
    "status": "requires-tier-remediation-and-owner-review",
    "billingCurrency": "AUD",
    "verifiedProviderPricing": { "provider": "Replicate", "model": "nightmareai/real-esrgan", "usdPerSuccessfulOutput": 0.002, "source": "official-provider-pricing" },
    "currentlyAdvertisedTiers": [
      { "id": "free", "monthlyAud": 0, "advertisedImages": 5, "batchSize": 1 },
      { "id": "standard", "monthlyAud": 10, "advertisedImages": 100, "batchSize": 10 },
      { "id": "pro", "monthlyAud": 15, "advertisedImages": 3000, "batchSize": 50 }
    ],
    "risk": "A flat image count treats a small web image and a multi-pass 140-megapixel fine-art output as equal, exposing the plan to storage, egress, memory, retry and tiled-processing cost blowouts",
    "proposedMeter": {
      "unit": "weighted-output-megapixel-credit",
      "standardOutputMegapixelsPerCredit": 25,
      "formula": "credits = ceil(outputMegapixels / 25) * upscalePassCount * featureMultipliers",
      "featureMultipliers": { "faceEnhancement": 1.5, "tiledProcessing": 1.25, "losslessLargeFile": 1.25 },
      "minimumCreditsPerJob": 1
    },
    "requiredAudit": ["provider-inference", "storage", "egress", "temporary-files", "retry-rate", "payment-fees", "support-overhead", "gross-margin-by-tier", "worst-case-usage"],
    "rules": [
      "Do not promise a raw image count until every tier passes worst-case and expected-use margin tests",
      "Show the credit estimate before upload or processing",
      "Deduct credits from calculated output work rather than input file count",
      "Reject or separately price jobs that exceed plan, job-cost or extreme-dimension ceilings",
      "Do not activate revised entitlements or pricing without owner approval"
    ]
  },
  "remediationRule": "Any failure or mismatch returns to the development workflow and requires new passing evidence before deployment approval"
}
