{
  "schemaVersion": "1.0.0",
  "enabled": false,
  "sampleCountPerPrompt": 4,
  "prompts": [],
  "targetProductTemplates": [],
  "promptStrategy": {
    "primary": "trend-informed-original-concept",
    "includeEvergreenControl": true,
    "styleCoverage": ["personal-handmade", "heritage-craft", "modern-maximalism", "surreal-dreamscape", "nostalgic", "playful-pattern"],
    "recordTrendEvidence": true,
    "rejectCopiedOrProtectedContent": true,
    "compileStructuredArtDirection": true,
    "minimumVisualComplexity": "authored-detailed-merchandise-illustration",
    "automaticPromptAvoid": ["generic app icon", "flat clip art", "stock-vector look", "large blank areas", "generic AI aesthetic"]
  },
  "stageBenchmarks": [
    {
      "id": "source-artwork-generation",
      "input": "matched-text-prompt",
      "providerCandidates": ["current-runware", "candidate-flux-schnell"],
      "requiredOutput": "isolated-print-artwork",
      "criteria": ["prompt-adherence", "originality", "composition", "visible-artifacts", "print-readiness", "effective-print-resolution", "transparency", "bleed-and-safe-area"]
    },
    {
      "id": "product-preview-generation",
      "input": "binary-identical-approved-source-artwork-and-same-product-template-placement-scale-background",
      "providerCandidates": ["current-runware", "candidate-flux-schnell"],
      "requiredOutput": "realistic-product-mockup",
      "criteria": ["source-artwork-pixel-preservation", "placement-accuracy", "scale-and-crop", "product-template-match", "fabric-or-surface-realism", "lighting-and-shadow", "colour-fidelity", "visible-artifacts"],
      "automaticFailure": ["source-artwork-redrawn", "source-artwork-restyled", "subject-or-detail-changed", "different-product-template-or-placement"],
      "preferredMethod": "deterministic-provider-mockup-api-or-template-compositing",
      "generativeImageToImageRole": "experimental-only-unless-pixel-preservation-passes"
    }
  ],
  "providerSelection": {
    "selectPerStage": true,
    "allowDifferentProvidersForArtworkAndPreview": true,
    "artworkProvider": "pending-owner-review",
    "previewProvider": "pending-owner-review",
    "rule": "A provider must pass the evidence and owner-review gate for its assigned stage; success in one stage does not qualify it for the other"
  },
  "providers": [
    { "id": "current-runware", "provider": "Runware", "model": null, "credentialEnv": "RUNWARE_API_KEY" },
    { "id": "candidate-flux-schnell", "provider": "fal.ai", "model": "FLUX.1 Schnell", "endpointId": "fal-ai/flux-1/schnell", "role": "draft-only", "clientPackage": "@fal-ai/client", "credentialEnv": "FAL_KEY" },
    { "id": "candidate-flux-pro-v1-1", "provider": "fal.ai", "model": "FLUX 1.1 Pro", "endpointId": "fal-ai/flux-pro/v1.1", "role": "final-artwork-default", "clientPackage": "@fal-ai/client", "credentialEnv": "FAL_KEY" }
  ],
  "analysis": {
    "provider": "Claude Vision",
    "blindProviderLabels": true,
    "criteria": ["prompt-adherence", "style-specificity", "subject-readability", "composition", "colour-harmony", "detail-quality", "originality", "text-quality", "visible-artifacts", "product-fit", "preview-quality", "template-dimensions", "effective-print-resolution", "transparency", "bleed-and-safe-area"],
    "minimumOverallScore": 80,
    "automaticFailure": ["generic-clip-art", "generic-app-icon", "large-unintended-blank-area", "missing-requested-style", "visible-generation-artifact", "watermark-or-unrequested-text"],
    "actionOnFailure": "reject-and-regenerate-with-targeted-correction",
    "operationalMetrics": ["latency", "cost-per-output", "failure-rate"]
  },
  "ownerReviewPresentation": {
    "showPrompt": true,
    "showRawRunwareOutput": true,
    "showRawFluxOutput": true,
    "createSideBySideImage": true,
    "labelProviderOutputs": true,
    "groupByPromptAndProduct": true,
    "batchSize": 4
  },
  "selectionRule": "No provider switch until the candidate passes print-readiness and owner review"
}
